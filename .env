# ========================================
# Task API - Environment Configuration
# ========================================

# Application
# Express API server port
PORT=3000


# ========================================
# PostgreSQL Database
# ========================================

# PostgreSQL is exposed from Docker:
# Host: 5433 -> Container: 5432
DATABASE_URL=postgresql://taskapi:taskapi@localhost:5433/taskdb


# ========================================
# Redis
# ========================================

# Redis is exposed from Docker:
# Host: 6380 -> Container: 6379
REDIS_URL=redis://localhost:6380


# ========================================
# Authentication / JWT
# ========================================

# Secret used to sign and verify JWT tokens
JWT_SECRET=7f4c9a2e8b1d6f3a0c5e9b7d2a8f1c6e4b0d9a3f7c2e6b8d1a5f9c3e7b0a2d6

# JWT token expiration time
JWT_EXPIRES_IN=1h
